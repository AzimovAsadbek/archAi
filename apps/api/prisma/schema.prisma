generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  CONFIGURED
  GENERATING
  READY
  ARCHIVED
  FAILED
}

enum HouseStyle {
  MODERN
  MINIMALIST
  CLASSIC
  TRADITIONAL
  EUROPEAN
  NATIONAL
}

enum RoomType {
  BEDROOM
  LIVING_ROOM
  KITCHEN
  BATHROOM
  DINING_ROOM
  OFFICE
  STORAGE
  LAUNDRY
  HALLWAY
  OTHER
}

enum AiGenerationKind {
  PARSE_PROJECT
}

enum AiGenerationStatus {
  SUCCEEDED
  FAILED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          UserRole       @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  refreshTokens RefreshToken[]
  aiGenerations AiGeneration[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)

  // Land (meters / m²)
  landAreaM2  Float?
  landWidthM  Float?
  landLengthM Float?

  // House
  houseWidthM  Float?
  houseLengthM Float?
  floorCount   Int?
  style        HouseStyle?

  // Features
  hasGarage  Boolean @default(false)
  hasTerrace Boolean @default(false)
  hasBalcony Boolean @default(false)
  hasPool    Boolean @default(false)
  hasGarden  Boolean @default(false)

  rooms     Room[]
  floorPlan FloorPlan?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([ownerId, status])
  @@index([ownerId, updatedAt])
  @@map("projects")
}

model Room {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      RoomType
  /// 0-based floor index
  floor     Int      @default(0)
  widthM    Float?
  lengthM   Float?
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("rooms")
}

/// Cached output of `@archai/floor-plan-engine` — one plan per project.
model FloorPlan {
  id            String   @id @default(cuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// FLOOR_PLAN_ENGINE_VERSION of the run that produced `geometry`.
  engineVersion String
  /// sha256 of the canonical FloorPlanInput JSON; a mismatch forces regeneration.
  inputHash     String
  /// Engine `FloorPlan` output, stored verbatim.
  geometry      Json
  /// Set explicitly on every regeneration (not on unrelated row writes).
  generatedAt   DateTime
  createdAt     DateTime @default(now())

  @@map("floor_plans")
}

/// Provenance of one AI call. Deliberately holds no prompt, request text or
/// model output — only who called, what answered, and how it went.
model AiGeneration {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          AiGenerationKind
  /// ArchitectureAIProvider.name, e.g. 'anthropic' | 'unconfigured'.
  provider      String
  model         String
  /// PARSE_PROJECT_PROMPT_VERSION of the run.
  promptVersion String
  status        AiGenerationStatus
  /// AiErrorCode when status is FAILED.
  errorCode     String?
  inputTokens   Int?
  outputTokens  Int?
  durationMs    Int
  createdAt     DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("ai_generations")
}
