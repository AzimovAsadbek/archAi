generator client {
  provider = "prisma-client-js"
  // `native` covers local dev and CI. The RHEL target is the query engine that
  // Vercel's Node runtime needs (Amazon Linux, OpenSSL 3) — without it the
  // deployed function builds fine and then fails on its first query.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection. On a serverless platform every concurrent invocation is
  // its own process, so unpooled connections exhaust the database long before
  // traffic does — this must point at Neon's pooler (`-pooler` in the host).
  url      = env("DATABASE_URL")
  // Migrations and introspection need a single unpooled session: the pooler
  // cannot hold the advisory lock a migration takes. Prisma requires this
  // variable to exist whenever the field is declared — there is no fallback to
  // `url` — so local and CI set it to the same value as DATABASE_URL, where
  // there is no pooler to bypass.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  CONFIGURED
  GENERATING
  READY
  ARCHIVED
  FAILED
}

enum HouseStyle {
  MODERN
  MINIMALIST
  CLASSIC
  TRADITIONAL
  EUROPEAN
  NATIONAL
}

enum RoomType {
  BEDROOM
  LIVING_ROOM
  KITCHEN
  BATHROOM
  DINING_ROOM
  OFFICE
  STORAGE
  LAUNDRY
  HALLWAY
  OTHER
}

enum AiGenerationKind {
  PARSE_PROJECT
  SUGGEST_IMPROVEMENTS
  ANSWER_QUESTION
}

enum AiGenerationStatus {
  SUCCEEDED
  FAILED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          UserRole       @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  refreshTokens RefreshToken[]
  aiGenerations AiGeneration[]
  auditLogs     AuditLog[]

  // Backs the admin users list (ORDER BY createdAt desc, no owner filter).
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(DRAFT)

  // Land (meters / m²)
  landAreaM2  Float?
  landWidthM  Float?
  landLengthM Float?

  // House
  houseWidthM  Float?
  houseLengthM Float?
  floorCount   Int?
  style        HouseStyle?

  // Features
  hasGarage  Boolean @default(false)
  hasTerrace Boolean @default(false)
  hasBalcony Boolean @default(false)
  hasPool    Boolean @default(false)
  hasGarden  Boolean @default(false)

  /// Layout optimization policy (shared LAYOUT_STRATEGIES); null = BALANCED.
  layoutStrategy String?

  rooms     Room[]
  floorPlan FloorPlan?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([ownerId, status])
  @@index([ownerId, updatedAt])
  // Backs the admin projects list (global ORDER BY updatedAt desc, no owner filter).
  @@index([updatedAt])
  @@map("projects")
}

model Room {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      RoomType
  /// 0-based floor index
  floor     Int      @default(0)
  widthM    Float?
  lengthM   Float?
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("rooms")
}

/// Cached output of `@archai/floor-plan-engine` — one plan per project.
model FloorPlan {
  id            String   @id @default(cuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// FLOOR_PLAN_ENGINE_VERSION of the run that produced `geometry`.
  engineVersion String
  /// sha256 of the canonical FloorPlanInput JSON; a mismatch forces regeneration.
  inputHash     String
  /// Engine `FloorPlan` output, stored verbatim.
  geometry      Json
  /// Set explicitly on every regeneration (not on unrelated row writes).
  generatedAt   DateTime
  createdAt     DateTime @default(now())

  @@map("floor_plans")
}

/// Versioned pricing rules for the estimate engine (docs/estimate.md §Rule model).
/// Exactly one row may be active: the migration adds a unique index on
/// `isActive` WHERE `isActive` = true, which Prisma cannot express in the schema.
model EstimateRule {
  id        String   @id @default(cuid())
  /// Echoed as provenance in every estimate, e.g. '1'.
  version   String
  /// `estimateRulesSchema` payload, re-validated on every read.
  data      Json
  /// At most one active row; the API prices with that one.
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("estimate_rules")
}

/// Trail of the admin panel (docs/admin.md §Backend): every mutation and every
/// cross-user read an administrator performs. Written in the same transaction as
/// the change it describes, so a mutation can never land unaudited.
model AuditLog {
  id        String   @id @default(cuid())
  /// Kept when the administrator's account is deleted — the record outlives them.
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Dot-namespaced, e.g. 'user.deactivate', 'estimate-rules.activate', 'users.list'.
  action    String
  /// Affected resource kind, e.g. 'user', 'project', 'estimate-rule'.
  entity    String
  entityId  String?
  /// Small context object; no PII beyond ids/emails an admin already sees.
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@map("audit_log")
}

/// Provenance of one AI call. Deliberately holds no prompt, request text or
/// model output — only who called, what answered, and how it went.
model AiGeneration {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          AiGenerationKind
  /// ArchitectureAIProvider.name, e.g. 'gemini' | 'groq' | 'mock' | 'unconfigured'.
  provider      String
  model         String
  /// PARSE_PROJECT_PROMPT_VERSION of the run.
  promptVersion String
  status        AiGenerationStatus
  /// AiErrorCode when status is FAILED.
  errorCode     String?
  inputTokens   Int?
  outputTokens  Int?
  durationMs    Int
  createdAt     DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("ai_generations")
}

/// Public FAQ entry (docs/public-content.md §FAQ). Global content — no owner.
/// `answer` is plain text / light markdown, rendered as paragraphs, never HTML.
model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
  @@map("faq_items")
}

/// Public blog post (docs/public-content.md §Blog). `body` is markdown stored as
/// TEXT — the API never renders it; the web renders it safely (no raw HTML).
model BlogPost {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  excerpt         String
  /// Markdown source. Returned verbatim; rendered safely by the web, not the API.
  body            String
  authorName      String
  category        String?
  tags            String[]
  coverImageUrl   String?
  status          BlogStatus @default(DRAFT)
  /// Stamped when a post first transitions DRAFT → PUBLISHED (or on publish-at-create).
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

/// Pricing plan (docs/public-content.md §Pricing). Data-modeled for the future;
/// presented as free during beta. No payment integration exists — `priceMonthly`
/// is informational and limits are NOT enforced in v1.
model PricingPlan {
  id           String   @id @default(cuid())
  /// FREE | BASIC | PRO — the stable display/lookup key.
  key          String   @unique
  name         String
  tagline      String
  /// UZS per month; 0 for the free plan.
  priceMonthly Int      @default(0)
  /// { projects, aiParsesPerMonth, pdfExportsPerMonth, storageMb } — null = unlimited.
  limits       Json
  /// Display bullet keys, in order.
  features     String[]
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("pricing_plans")
}
