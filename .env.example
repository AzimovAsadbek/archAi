# ── Database ──────────────────────────────────────────────────────────────
# Copy this file to apps/api/.env (Prisma and the API read it from there).
DATABASE_URL="postgresql://archai:archai_dev_password@localhost:5433/archai?schema=public"
TEST_DATABASE_URL="postgresql://archai:archai_dev_password@localhost:5433/archai_test?schema=public"

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# JWT secrets — generate long random values for every environment.
JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-different-64-random-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Set to true when serving over HTTPS (production).
COOKIE_SECURE=false

# ── AI (server-side only — never expose to the browser) ───────────────────
# Required for the AI-assisted project parsing features (vertical slice 2+).
ANTHROPIC_API_KEY=

# ── Web (apps/web/.env.local if you need to override) ─────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
