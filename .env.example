# ── Database ──────────────────────────────────────────────────────────────
# Copy this file to apps/api/.env (Prisma and the API read it from there).
DATABASE_URL="postgresql://archai:archai_dev_password@localhost:5433/archai?schema=public"
TEST_DATABASE_URL="postgresql://archai:archai_dev_password@localhost:5433/archai_test?schema=public"
# Unpooled connection, used only by `prisma migrate` — a pooler cannot hold the
# advisory lock a migration takes. Locally there is no pooler, so it is the same
# URL; Prisma requires the variable to exist either way. On Neon this is the
# host WITHOUT `-pooler`, while DATABASE_URL is the one WITH it.
DIRECT_DATABASE_URL="postgresql://archai:archai_dev_password@localhost:5433/archai?schema=public"

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# JWT secrets — generate long random values for every environment.
JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-different-64-random-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Set to true when serving over HTTPS (production).
COOKIE_SECURE=false

# Trusted reverse-proxy hops in front of the API. 0 = none (the socket IP is the
# client). Behind a TLS-terminating proxy this MUST match the real hop count, or
# the per-IP rate limiter keys on the proxy and throttles every user as one.
TRUST_PROXY_HOPS=0

# ── Runtime AI (free-tier-first; server-side only — never expose to browser) ─
# Primary provider: gemini | groq | mock. `mock` needs no key (dev/tests).
AI_PROVIDER=gemini
# Fallback tried only when the primary errors: gemini | groq | mock | none.
AI_FALLBACK_PROVIDER=groq
# Gemini API key (https://aistudio.google.com/apikey). Empty = AI answers 503.
GEMINI_API_KEY=
# Groq API key (https://console.groq.com/keys). Needed for the fallback.
GROQ_API_KEY=
# Optional model overrides; default to each provider's verified model.
AI_PRIMARY_MODEL=gemini-flash-latest
AI_FALLBACK_MODEL=openai/gpt-oss-120b
# Per-user requests/day (0 = unlimited); provider free-tier limits still apply.
AI_MAX_REQUESTS_PER_USER_PER_DAY=20
# Per-provider request timeout (ms) and same-provider transient retries.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# ── Web (apps/web/.env.local if you need to override) ─────────────────────
# Absolute origin in development, where the API runs on its own port.
# In production set this to `same-origin` so the browser sends relative
# /api/v1/... URLs into the rewrite below — that keeps the session cookies
# first-party and works on preview deployments without hardcoding a hostname.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side only: where the web deployment proxies /api/v1/* to. Set this on
# the web project in production (the API deployment's origin); leave it unset
# locally, where the browser talks to the API directly.
# API_ORIGIN=https://archai-api.vercel.app
