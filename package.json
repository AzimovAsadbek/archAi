{
  "name": "archai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently -n shared,api,web -c blue,green,magenta \"pnpm --filter @archai/shared dev\" \"pnpm --filter @archai/api start:dev\" \"pnpm --filter @archai/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @archai/api prisma:migrate",
    "db:seed": "pnpm --filter @archai/api prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.0"
  }
}
